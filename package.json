{
  "name": "tonie-jukebox",
  "version": "1.0.0",
  "description": "A NodeJS server that serves a small website to easily add new music to your creative Tonie.",
  "keywords": [
    "toniebox",
    "youtube",
    "music"
  ],
  "license": "GPL-3.0",
  "author": "bra1n",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "update-yt-dlp": "npm rebuild youtube-dl-exec --ignore-scripts=false",
    "test": "node --test",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include=\"*.js\" --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=70"
  },
  "dependencies": {
    "express": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "youtube-dl-exec": "^3.1.17"
  },
  "engines": {
    "node": ">=22.9"
  }
}
